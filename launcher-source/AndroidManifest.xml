<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="local.tvhome" android:versionCode="5" android:versionName="1.4">
    <uses-sdk android:minSdkVersion="21" android:targetSdkVersion="29" />
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application android:label="Home" android:icon="@drawable/icon" android:banner="@drawable/banner"
        android:allowBackup="false" android:largeHeap="false"
        android:theme="@android:style/Theme.Material.NoActionBar.Fullscreen">

        <activity android:name=".HomeActivity" android:launchMode="singleTask"
            android:stateNotNeeded="true" android:excludeFromRecents="true"
            android:screenOrientation="landscape" android:resumeWhilePausing="true"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|uiMode|density">
            <intent-filter android:priority="2">
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity android:name=".AppsActivity" android:excludeFromRecents="true"
            android:screenOrientation="landscape" />
    </application>
</manifest>
